<instructions>
   <msis>
      <msi name="VisaSharedComponentsWrapperCore.msi">
         <property name="INSTALLLEVEL" value="1000" />
      </msi>
   </msis>
   <customExecutes>
      <customExecute exeName="VisaSharedComponentsInstaller.exe" arguments="VisaSharedComponents32.msi" inPackage="y" schedule="pre" wait="y" condition="NOT VersionNT64" returnCodeConvention="installer"/>
      <customExecute exeName="VisaSharedComponentsInstaller.exe" arguments="VisaSharedComponents64.msi" inPackage="y" schedule="pre" wait="y" condition="VersionNT64" returnCodeConvention="installer"/>
   </customExecutes>
</instructions>
